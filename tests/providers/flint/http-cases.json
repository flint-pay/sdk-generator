  {
    "name": "create uses current required payment options and preserves exact amount",
    "operation": "createPaymentIntent",
    "baseUrl": "https://api.example.invalid",
    "input": {
      "body": {
        "amount_money": {
          "amount": "9007199254740993",
          "currency": "USD"
        },
        "payment_options": ["card"],
        "capture_method": "manual"
      }
    },
    "expected": {
      "method": "POST",
      "path": "/v1/payment-intents",
      "headers": {
        "authorization": "Bearer test-token",
        "idempotency-key": "durable-create-key",
        "flint-version": "2026-09-07"
      },
      "body": "{\"amount_money\":{\"amount\":9007199254740993,\"currency\":\"USD\"},\"payment_options\":[\"card\"],\"capture_method\":\"manual\"}"
    },
    "responses": [
      {
        "transportError": true
      },
      {
        "status": 201,
        "headers": {
          "x-request-id": "req_fixture"
        },
        "body": "{\"data\":{\"payment_collection\":{},\"payment_intent\":{\"amount_money\":{\"amount\":9007199254740993,\"currency\":\"USD\"},\"payment_flow\":\"api\",\"payment_intent_id\":\"pi_fixture\",\"payment_options\":[\"card\"],\"status\":\"requires_capture\",\"support_reference\":\"support_fixture\",\"risk\":null,\"last_payment_error\":null}}}"
      }
    ],
    "data": {
      "data": {
        "payment_collection": {},
        "payment_intent": {
          "amount_money": {
            "amount": "9007199254740993",
            "currency": "USD"
          },
          "payment_flow": "api",
          "payment_intent_id": "pi_fixture",
          "payment_options": ["card"],
          "status": "requires_capture",
          "support_reference": "support_fixture",
          "risk": null,
          "last_payment_error": null
        }
      }
    },
    "options": {
      "idempotencyKey": "durable-create-key",
      "headers": {
        "fLiNt-VeRsIoN": "2026-02-01"
      }
    },
    "attempts": 2
  },
