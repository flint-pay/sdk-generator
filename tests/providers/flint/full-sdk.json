      }
    },
    "updateInventoryCount": {
      "example": {
        "Idempotency-Key": "example",
        "inventory_count_id": "example",
        "body": {
          "expected_version": "2",
          "observations": [
            {
              "counted_damaged_quantity": "0",
              "counted_on_hand_quantity": "12",
              "counted_quality_control_quantity": "0",
              "counted_quarantined_quantity": "0",
