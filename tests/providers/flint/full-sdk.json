        }
      }
    },
    "exchangePartnerInstallToken": {
      "requestMediaType": "application/json"
    },
    "addRiskListItems": {
      "example": {
        "risk_list_id": "example",
        "body": {
          "values": ["sdk-example"]
        }
      }
    },
    "createPaymentMethodDomain": {
      "example": {
        "body": {
          "domain_name": "payments.example.invalid"
        }
      }
    },
