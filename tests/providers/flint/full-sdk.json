              "quantity": "1"
            }
          ]
        }
      }
    },
    "createRiskPreview": {
      "example": {
        "body": {
          "risk_rule_id": "rr_example"
        }
      }
    },
    "createRiskRule": {
      "example": {
        "body": {
          "action": "review",
          "description": "Synthetic SDK example",
          "predicate": {
            "attribute": "payment_method_type",
            "operator": "eq",
            "value": "card"
          }
        }
      }
    },
    "createDeliveryMethod": {
      "example": {
        "body": {
          "configuration": {
            "origin": {
              "location_id": "loc_01K1P6G4M7H2N8Q9R3S5T6V7WX",
              "type": "fixed_location"
            },
            "pricing": {
              "calculated": {},
              "type": "calculated"
            },
            "minimum_option_lifetime_seconds": "120"
          },
          "type": "shipment",
          "name": "Standard shipping"
        }
      }
    },
    "createDeliveryZone": {
      "example": {
        "body": {
          "configuration": {
            "country": {
              "values": ["example"]
            }
          },
          "name": "Standard delivery"
        }
      }
    },
    "updateDeliveryMethod": {
      "example": {
