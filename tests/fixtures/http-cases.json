[
  {
    "name": "exact amount and decimal",
    "operation": "createPayment",
    "input": {
      "X-Tenant": "shop-a",
      "body": {
        "amount": "9007199254740993",
        "currency": "USD",
        "reference": "order",
        "description": null,
        "fee": "0.10000000000000000001"
      }
    },
    "options": {
      "idempotencyKey": "persisted-key"
    },
    "expected": {
      "method": "POST",
      "path": "/v1/payments",
      "headers": {
        "authorization": "Bearer test-token",
        "idempotency-key": "persisted-key",
        "x-tenant": "shop-a",
        "x-api-version": "2026-09-fixture",
        "content-type": "application/json"
      },
      "body": "{\"amount\":9007199254740993,\"currency\":\"USD\",\"reference\":\"order\",\"description\":null,\"fee\":0.10000000000000000001}"
    },
    "responses": [
      {
        "status": 201,
        "body": "{\"id\":\"p1\",\"amount\":9007199254740993,\"status\":\"future_state\",\"new_field\":true}"
      }
    ],
    "data": {
      "id": "p1",
      "amount": "9007199254740993",
      "status": "future_state",
      "new_field": true
    }
  },
  {
    "name": "encoded path",
    "operation": "getPayment",
    "input": {
      "id": "a/b !"
    },
    "expected": {
      "method": "GET",
      "path": "/v1/payments/a%2Fb%20%21"
    },
    "responses": [
      {
        "status": 200,
        "body": "{\"id\":\"p1\",\"amount\":100,\"status\":\"pending\"}"
      }
    ],
    "data": {
      "id": "p1",
      "amount": "100",
      "status": "pending"
    }
  },
  {
    "name": "repeated query",
    "operation": "listPayments",
    "input": {
      "tag": ["a b", "x/y"]
    },
    "expected": {
      "method": "GET",
      "path": "/v1/payments?tag=a%20b&tag=x%2Fy"
    },
    "responses": [
      {
        "status": 200,
        "body": "{\"items\":[],\"next\":null}"
      }
    ],
    "data": {
      "items": [],
      "next": null
    }
  },
