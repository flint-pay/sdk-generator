        "transportError": true
      },
      {
        "transportError": true
      }
    ],
    "error": {
      "kind": "transport",
      "outcome": "unknown",
      "retryAllowed": true
    },
    "attempts": 3
  },
  {
    "name": "HTML intermediary error preserves metadata",
    "operation": "getPayment",
    "input": {
      "id": "p1"
    },
    "options": {
      "maxAttempts": 1
    },
    "expected": {
      "method": "GET",
      "path": "/v1/payments/p1"
    },
    "responses": [
      {
        "status": 503,
        "headers": {
          "x-request-id": "req-html"
        },
        "body": "<html>upstream unavailable</html>"
      }
    ],
    "error": {
      "kind": "api",
      "outcome": "response",
      "status": 503,
      "requestId": "req-html"
    }
  },
  {
    "name": "invalid JSON success",
    "operation": "getPayment",
    "input": {
      "id": "p1"
    },
    "expected": {
      "method": "GET",
      "path": "/v1/payments/p1"
    },
    "responses": [
      {
        "status": 200,
        "body": "{bad json"
      }
    ],
    "error": {
      "kind": "protocol",
      "outcome": "response",
      "status": 200
    }
  },
  {
    "name": "conditional conflict",
    "operation": "updatePayment",
    "input": {
      "id": "p1",
      "body": {
        "description": null
      }
    },
    "options": {
      "ifMatch": "version-1"
    },
    "expected": {
      "method": "PATCH",
      "path": "/v1/payments/p1",
      "headers": {
        "if-match": "version-1"
      }
    },
    "responses": [
      {
        "status": 412,
        "body": "{\"code\":\"stale_version\"}"
      }
    ],
    "error": {
      "kind": "conflict",
      "outcome": "response",
      "status": 412,
      "retryAllowed": false
    }
  },
  {
    "name": "redirect rejected",
