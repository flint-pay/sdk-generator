  {
    "name": "same key after missing response",
    "operation": "createPayment",
    "input": {
      "body": {
        "amount": "100",
        "currency": "USD",
        "reference": "order"
      }
    },
    "options": {
      "idempotencyKey": "restart-key"
    },
    "expected": {
      "method": "POST",
      "path": "/v1/payments",
      "headers": {
        "idempotency-key": "restart-key"
      }
    },
    "responses": [
      {
        "transportError": true
      },
      {
        "status": 201,
        "body": "{\"id\":\"p1\",\"amount\":100,\"status\":\"succeeded\"}"
      }
    ],
    "data": {
      "id": "p1",
      "amount": "100",
      "status": "succeeded"
    },
    "attempts": 2
  },
  {
    "name": "unknown final transport outcome",
    "operation": "createPayment",
    "input": {
      "body": {
        "amount": "100",
        "currency": "USD",
        "reference": "order"
      }
    },
    "options": {
      "idempotencyKey": "restart-key"
