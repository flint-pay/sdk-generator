[
  {
    "name": "Lambda runtime",
    "source": "aws",
    "platformEnvironment": {
      "AWS_EXECUTION_ENV": "AWS_Lambda_nodejs22.x"
    },
    "token": {},
    "expect": "ok"
  },
  {
    "name": "ECS runtime",
    "source": "aws",
    "platformEnvironment": {
      "AWS_EXECUTION_ENV": "AWS_ECS_FARGATE"
    },
    "token": {},
    "expect": "ok"
  },
  {
    "name": "Lambda function",
    "source": "aws",
    "platformEnvironment": {
      "AWS_LAMBDA_FUNCTION_NAME": "synthetic-function"
    },
    "token": {},
    "expect": "ok"
  },
  {
    "name": "ECS v3",
    "source": "aws",
    "platformEnvironment": {
      "ECS_CONTAINER_METADATA_URI": "http://synthetic.invalid"
    },
    "token": {},
    "expect": "ok"
  },
  {
    "name": "ECS v4",
    "source": "aws",
    "platformEnvironment": {
      "ECS_CONTAINER_METADATA_URI_V4": "http://synthetic.invalid"
    },
    "token": {},
    "expect": "ok"
  },
  {
    "name": "explicit AWS without platform marker",
    "source": "aws",
    "explicit": true,
    "token": {},
    "expect": "ok"
  },
  {
    "name": "AWS wrong audience",
    "source": "aws",
    "explicit": true,
    "token": {
      "aud": "foreign"
    },
    "expect": "audience_mismatch"
  },
  {
    "name": "AWS expired",
    "source": "aws",
    "explicit": true,
    "token": {
      "expOffset": -1
    },
    "expect": "audience_mismatch"
  },
  {
    "name": "AWS SDK failure",
    "source": "aws",
    "explicit": true,
    "sdkFailure": true,
    "expect": "subject_token_request_failed"
  },
  {
    "name": "AWS SDK missing",
    "source": "aws",
    "explicit": true,
    "missing": true,
    "expect": "source_unavailable"
  },
  {
    "name": "unrelated AWS runtime is not an auto marker",
    "source": "aws",
    "platformEnvironment": {
      "AWS_EXECUTION_ENV": "synthetic-unrelated"
    },
    "expect": "source_unavailable",
    "noSource": true
  },
  {
    "name": "CLI session cache",
    "source": "cli",
    "expect": "ok"
  },
  {
    "name": "CLI missing",
    "source": "cli",
    "missing": true,
    "expect": "no_credentials"
  },
  {
    "name": "CLI API key refusal",
    "source": "cli",
    "error": "API_KEY_NOT_EXPORTABLE",
    "expect": "source_unavailable"
  },
  {
    "name": "CLI invalid JSON",
    "source": "cli",
    "raw": "synthetic-not-json",
    "expect": "source_unavailable"
  },
  {
    "name": "CLI expired",
    "source": "cli",
    "expires": "2000-01-01T00:00:00Z",
    "expect": "source_unavailable"
  },
  {
    "name": "CLI expiry omitted",
    "source": "cli",
    "noExpiry": true,
    "expect": "ok"
  },
  {
    "name": "CLI disabled",
    "source": "cli",
    "disabled": true,
    "expect": "no_credentials",
    "exports": 0
  },
  {
    "name": "ambient disabled also disables CLI",
    "source": "cli",
    "ambientDisabled": true,
    "expect": "credential_missing",
    "exports": 0
  },
  {
    "name": "federation failure does not fall back to CLI",
    "source": "cli",
    "identity": true,
    "expect": "source_unavailable",
    "exports": 0
  },
  {
    "name": "CLI process timeout",
    "source": "cli",
    "hang": true,
    "expect": "source_unavailable"
  },
  {
    "name": "CLI output limit",
    "source": "cli",
    "large": true,
    "expect": "source_unavailable"
  },
  {
    "name": "CLI 401 exports again",
    "source": "cli",
    "cliAPI401": true,
    "expect": "ok",
    "exports": 2
  },
  {
    "name": "CLI not logged in",
    "source": "cli",
    "error": "API_KEY_REQUIRED",
    "expect": "no_credentials"
  }
]
